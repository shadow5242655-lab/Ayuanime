{
  "version": 2,
  "installCommand": "cd seanime-web && npm install --include=dev --no-audit --no-fund",
  "buildCommand": "cd seanime-web && SEA_PUBLIC_PLATFORM=web npm run build",
  "outputDirectory": "seanime-web/out",
  "env": {
    "SEA_PUBLIC_PLATFORM": "web"
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
