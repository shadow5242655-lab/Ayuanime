{
  "version": 2,
  "installCommand": "cd seanime-web && npm ci --include=dev",
  "buildCommand": "cd seanime-web && npm ci --include=dev && SEA_PUBLIC_PLATFORM=web npm run build",
  "outputDirectory": "seanime-web/out",
  "env": {
    "SEA_PUBLIC_PLATFORM": "web"
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
